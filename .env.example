# ── Core (required in production) ─────────────────────────────────────────────
SECRET_KEY=change_me_to_a_random_64_char_string
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── Admin seed (used only on first DB init) ───────────────────────────────────
ADMIN_EMAIL=admin@yourcompany.com
ADMIN_PASSWORD=change_me_strong_password

# ── Twilio SMS/WhatsApp alerts (optional) ─────────────────────────────────────
# Get from https://console.twilio.com
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
# For SMS:        TWILIO_FROM=+1XXXXXXXXXX
# For WhatsApp:   TWILIO_FROM=whatsapp:+14155238886
TWILIO_FROM=+1XXXXXXXXXX
ADMIN_PHONE=+91XXXXXXXXXX   # number that receives alerts

# ── Email / SMTP (optional — needed for monthly PDF reports) ──────────────────
MAIL_SERVER=smtp.sendgrid.net
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=apikey
MAIL_PASSWORD=SG.xxxxxxxxxxxxxxxxxxxxxxxx
ADMIN_EMAIL_RECIPIENT=admin@yourcompany.com

# ── Render.com deployment detection (set automatically by Render) ──────────────
# RENDER=true
